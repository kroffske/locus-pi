#!/usr/bin/env node
import { readFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const command = process.argv[2] ?? "help";
const root = dirname(dirname(fileURLToPath(import.meta.url)));
const packagePath = join(root, "package.json");
const pkg = JSON.parse(readFileSync(packagePath, "utf8"));

function printHelp() {
  console.log(`${pkg.name} ${pkg.version}`);
  console.log("");
  console.log("Pi extension package for Locus agentic development workflows.");
  console.log("");
  console.log("Usage:");
  console.log("  npx @kroffske/locus-pi");
  console.log("  npx @kroffske/locus-pi doctor");
  console.log("  npx @kroffske/locus-pi check-workflow-source <path>");
  console.log("");
  console.log("Install into Pi:");
  console.log("  pi install npm:@kroffske/locus-pi");
  console.log("");
  console.log("After install, run Pi in a trusted project and use /devext doctor.");
}

async function checkWorkflowSource(args) {
  if (args.length !== 1) {
    console.error("Usage: npx @kroffske/locus-pi check-workflow-source <path>");
    process.exitCode = 2;
    return;
  }

  const requestedPath = args[0];
  const sourcePath = resolve(process.cwd(), requestedPath);
  let source;
  try {
    source = readFileSync(sourcePath, "utf8");
  } catch (error) {
    console.error(`${requestedPath}: unable to read source: ${error instanceof Error ? error.message : String(error)}`);
    process.exitCode = 1;
    return;
  }

  const checkerUrl = pathToFileURL(join(root, "dist/workflow-source-shape.mjs")).href;
  const { standardWorkflowSourceShapeErrors } = await import(checkerUrl);
  const errors = standardWorkflowSourceShapeErrors(source);
  if (errors.length === 0) {
    console.log(`${requestedPath}: standard source shape passed`);
    return;
  }

  console.error(`${requestedPath}: standard source shape failed`);
  for (const error of errors) console.error(`  - ${error}`);
  process.exitCode = 1;
}

/**
 * Report the installed package surface. Reads the same module `/devext doctor` reads, so the two
 * diagnostics cannot disagree about which extensions this installation declares.
 */
async function printDoctor() {
  const inventoryUrl = pathToFileURL(join(root, "extensions/devext-doctor/package-inventory.mjs")).href;
  const { readPackageInventory, countBy } = await import(inventoryUrl);
  const inventory = readPackageInventory(root);

  console.log(`${inventory.name} ${inventory.version}`);
  console.log(`package root: ${inventory.packageRoot}`);
  console.log(`declared entrypoints: ${inventory.rows.length}`);
  for (const row of inventory.rows) {
    const detail = row.state === "ok" ? `${row.id} (risk=${row.risk}, ownership=${row.ownership})` : row.problem;
    console.log(`- ${row.state === "ok" ? "ok" : row.state}: ${row.entrypoint} — ${detail}`);
  }
  console.log(`risk: ${countBy(inventory.rows, "risk").join(" ") || "none"}`);
  console.log(`ownership: ${countBy(inventory.rows, "ownership").join(" ") || "none"}`);

  if (inventory.problems.length === 0) return;
  console.error(`${inventory.problems.length} problem(s) found:`);
  for (const problem of inventory.problems) console.error(`  - ${problem}`);
  process.exitCode = 1;
}

switch (command) {
  case "help":
  case "--help":
  case "-h":
    printHelp();
    break;
  case "doctor":
    await printDoctor();
    break;
  case "check-workflow-source":
    await checkWorkflowSource(process.argv.slice(3));
    break;
  default:
    console.error(`Unknown command: ${command}`);
    console.error("Try: npx @kroffske/locus-pi --help");
    process.exit(2);
}
