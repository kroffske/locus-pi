    "Pi 0.82.0 custom footer API",
    "Pi footer data provider for Git branch",
    "Pi context-usage API",
    "session_before_compact and session_compact lifecycle events"
  ],
  "stateUsed": ["read-only current working directory and Git branch", "ephemeral compaction display state"],
  "tier": "core-owned",
  "provides": {
    "tools": [],
