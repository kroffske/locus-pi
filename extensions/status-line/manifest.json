{
  "id": "status-line",
  "name": "status-line",
  "agent": {
    "name": "extension-status-line",
    "description": "Maintain the responsive Locus footer without hiding Pi session evidence."
  },
  "version": "0.1.0",
  "defaultEnabled": true,
  "behaviorStatus": "active",
  "ownershipStatus": "locus-owned",
  "sourceMode": "local",
