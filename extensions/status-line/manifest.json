  "permissions": {
    "filesystem": {
      "read": [],
      "write": []
    },
    "subprocess": [],
    "network": [],
    "browser": false,
    "models": false,
    "ui": ["setFooter"]
  },
  "risk": "low",
  "docsPath": "docs/extensions/active/status-line.md",
  "sourceAuditPath": "https://github.com/kroffske/locus-pi/blob/main/docs/source-audit/status-line.md",
  "tests": ["tests/extensions/status-line/status-line.test.ts", "tests/integration/public-registration.test.ts"],
  "review": {
    "status": "reviewed",
    "source": "local-implementation",
    "reviewedBy": "locus-pi",
    "reviewedAt": "2026-08-05"
  }
}
