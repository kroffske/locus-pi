@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Curated review workflow — C4 component view

LAYOUT_LEFT_RIGHT()

AddElementTag("workflow", $bgColor="#F3E8FF", $fontColor="#581C87", $borderColor="#7E22CE", $legendText="Trusted workflow orchestration")
AddElementTag("agent", $bgColor="#EFF6FF", $fontColor="#172554", $borderColor="#1D4ED8", $legendText="Full tool-using child agent")
AddElementTag("evidence", $bgColor="#F8FAFC", $fontColor="#0F172A", $borderColor="#64748B", $legendText="Durable evidence or approval artifact")

Person(operator, "Operator", "Requests a review, reads the report, and decides which findings may be fixed.")

System_Boundary(review_system, "Locus Pi curated review") {
    Container_Boundary(workflow_runtime, "Workflow runtime — Node.js / Pi extension host") {
        Component(coordinator, "Review coordinator", "review.workflow.mjs", "Trusted local orchestration. Routes prompts and structured handoffs; it does not inspect Git, files, or forge APIs.", $tags="workflow")
        Component(schema_gate, "Stage and schema gate", "Workflow DSL", "Runs phases, waits for parallel work, validates structured outputs, and fails closed when required evidence is unavailable.", $tags="workflow")
        Component(agent_bridge, "Agent session bridge", "TypeScript / Pi host adapter", "Creates full child sessions with the oracle profile, project workspace, tool access, and bounded calls.", $tags="workflow")
    }

    Container_Boundary(agent_runtime, "Five full agent sessions — Pi child-session runtime") {
        Component(target_agent, "Agent 1 — Target resolver", "Full oracle child session", "Resolves the branch, working tree, or pull request; proves access; freezes the exact snapshot.", $tags="agent")
        Component(change_agent, "Agent 2 — Change reviewer", "Full oracle child session", "Inspects the diff and changed lines; reports defects introduced by the reviewed change.", $tags="agent")
        Component(context_agent, "Agent 3 — Context reviewer", "Full oracle child session", "Reads whole files, callers, configuration, tests, and prior claims around the changed surface.", $tags="agent")
        Component(adjudicator_agent, "Agent 4 — Adjudicator", "Full oracle child session", "Re-checks evidence, removes duplicates and weak claims, and produces the final machine-readable findings.", $tags="agent")
        Component(publisher_agent, "Agent 5 — Evidence publisher", "Full oracle child session", "Creates the review task, immutable reader report, and an all-pending human approval plan.", $tags="agent")
    }

    ContainerDb(run_journal, "Workflow journal", "journal.ndjson", "Phase, child-session, model, status, timing, and runtime evidence.", $tags="evidence")
    ContainerDb(review_artifacts, "Review artifacts", ".tasks/<task>/artifacts/*.md", "Immutable review.md plus fix-plan.md with per-finding pending, accepted, waived, or deferred dispositions.", $tags="evidence")
}

System_Ext(review_target, "Reviewed target", "Local Git working tree, branch comparison, or remote pull request. Review agents inspect it without intended mutation.")
System_Ext(model_provider, "Configured model provider", "Model selected by Pi role routing for each full child session.")

Rel_R(operator, coordinator, "Submits free-form review intent", "Workflow input")
Rel_R(coordinator, schema_gate, "Starts phases and supplies result contracts", "Workflow DSL")
Rel_R(schema_gate, agent_bridge, "Requests bounded child-agent work", "agent() / parallel()")

Rel_R(agent_bridge, target_agent, "Launches target resolution", "TARGET_SCHEMA")
Rel_D(target_agent, change_agent, "Hands off the frozen target", "via coordinator")
Rel_R(target_agent, context_agent, "Hands off the same frozen target", "via coordinator")
Rel_D(change_agent, adjudicator_agent, "Returns change-focused findings", "LANE_SCHEMA")
Rel_D(context_agent, adjudicator_agent, "Returns context-focused findings", "LANE_SCHEMA")
Rel_D(adjudicator_agent, publisher_agent, "Returns verified final findings", "REPORT_SCHEMA")
Rel_R(publisher_agent, review_artifacts, "Writes immutable report and all-pending plan", "Markdown + SHA-256")

Rel_U(agent_bridge, model_provider, "Routes child-session inference", "Pi model routing")
Rel_R(agent_bridge, review_target, "Creates project-workspace sessions; agents inspect the target with existing tools", "workspaceMode=project")
Rel_D(schema_gate, run_journal, "Records phases and terminal state", "NDJSON")
Rel_D(agent_bridge, run_journal, "Records child-session and model evidence", "NDJSON")

Rel_D(operator, review_artifacts, "Reads review.md and edits only dispositions in fix-plan.md", "Human approval gate")

SHOW_LEGEND()
@enduml
