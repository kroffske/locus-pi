      "fontFamily": 5,
      "text": "Curated review-fix workflow — agent-planned finding DAG, one writer per finding, fresh re-review",
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 26,
      "containerId": null,
      "originalText": "Curated review-fix workflow — agent-planned finding DAG, one writer per finding, fresh re-review",
      "lineHeight": 1.22
    },
    {
      "id": "tPw9Aa7UPSKe4QyL106i",
      "angle": 0,
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
